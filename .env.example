# HesLab PostHog Analytics Environment Configuration
# Project API Key from your PostHog Project Settings (starts with phc_...)
VITE_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_api_key_here

# PostHog Ingestion Host
# Cloud US: https://us.i.posthog.com
# Cloud EU: https://eu.i.posthog.com
# Or your custom reverse-proxy domain
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Canonical Site URL
VITE_SITE_URL=https://heslab.space

# Cloudflare R2 / External Video CDN Base URL (Zero Egress bandwidth)
# Example: https://pub-xxxxxxxxxxxxxxxx.r2.dev or custom domain https://media.heslab.studio
# Leave empty in local dev to serve fallback videos directly from public/
VITE_MEDIA_URL=
